# ── Famacon Control — environment TEMPLATE (copy to .env and fill) ──
NODE_ENV=
TZ=

# Postgres / TimescaleDB
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
APP_DB_USER=
APP_DB_PASSWORD=
DATABASE_URL=

# Redis (BullMQ)
REDIS_URL=

# MQTT broker
MQTT_URL=
MQTT_USER=
MQTT_PASSWORD=

# App
APP_PORT=
APP_SECRET=
PUBLIC_DOMAIN=

# Internal dashboard basic-auth (Item B, Famacon-only)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Weather API (Open-Meteo — free, no key needed by default)
WEATHER_API_BASE=

# WhatsApp Cloud API (filled at M3 — test number first)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
